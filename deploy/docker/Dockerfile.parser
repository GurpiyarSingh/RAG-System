# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# rag-parser image: parse-worker only. Adds Docling (layout analysis, table
# structure, OCR) and its models to the app image. Several GB in total, which is
# why it's kept out of the latency-sensitive API images.
# ---------------------------------------------------------------------------
ARG PYTHON_IMAGE=python:3.14.9-slim-trixie
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.6

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS builder
COPY --from=uv /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_CACHE_DIR=/root/.cache/uv \
    UV_HTTP_TIMEOUT=300
WORKDIR /app

# The `parser` extra pulls Docling and CPU-only PyTorch (see [tool.uv.sources]).
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-install-project --extra parser

COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY migrations/ migrations/
COPY src/ src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra parser

ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken
RUN /app/.venv/bin/python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

# Bake Docling's layout / table / OCR models into the image. Containers then start
# without downloading hundreds of MB, and work offline and reproducibly.
ENV DOCLING_ARTIFACTS_PATH=/opt/docling-models
RUN /app/.venv/bin/docling-tools models download --output-dir "${DOCLING_ARTIFACTS_PATH}"

FROM ${PYTHON_IMAGE} AS runtime
# libgl1 / libglib2.0-0: required by OpenCV, which Docling uses for image processing.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=builder --chown=app:app /app /app
COPY --from=builder --chown=app:app /opt/tiktoken /opt/tiktoken
COPY --from=builder --chown=app:app /opt/docling-models /opt/docling-models
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TIKTOKEN_CACHE_DIR=/opt/tiktoken \
    DOCLING_ARTIFACTS_PATH=/opt/docling-models \
    # Libraries that would otherwise try to write caches into the (read-only) home dir.
    HF_HOME=/tmp/hf \
    XDG_CACHE_HOME=/tmp/cache \
    # Keep PyTorch from spawning one thread per host core inside a 2-CPU container.
    OMP_NUM_THREADS=2

USER app
ENTRYPOINT ["tini", "--", "rag-service"]
CMD ["worker", "parse"]
