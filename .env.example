# =============================================================================
# RAG service configuration. Copy to .env (git-ignored) and fill in the secrets:
#   python scripts/gen_env.py     # creates .env with random secrets
#
# Values here are for tools running directly on the host (tests, scripts).
# Containers get Compose service hostnames from compose.yaml instead.
# =============================================================================

# ---- General -----------------------------------------------------------------
RAG_ENV=local
RAG_LOG_LEVEL=INFO
RAG_LOG_FORMAT=json

# ---- OpenAI ------------------------------------------------------------------
# Placeholder until you add a real key. The stack still starts; model calls return a
# clear 503 "model-not-configured" error.
OPENAI_API_KEY=sk-your-openai-key-here
RAG_LLM_MODEL=gpt-4o
RAG_LLM_UTILITY_MODEL=gpt-4o-mini
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=1024
# Your key's limits (OpenAI dashboard → Limits); the client-side limiter stays below them.
RAG_OPENAI_RPM_LIMIT=500
RAG_OPENAI_TPM_LIMIT=200000

# ---- PostgreSQL (your local PostgreSQL 18 install) ---------------------------
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=5432
RAG_DB_NAME=rag
RAG_DB_OWNER_PASSWORD=change-me-owner
RAG_DB_APP_PASSWORD=change-me-app
# Where psql/pg_dump live (used by `uv run poe db-init` and backups).
RAG_PG_BIN=D:\C Drive\PostgreSQL\bin
# Host-side integration tests use a separate database on the same server.
RAG_TEST_DATABASE_URL=postgresql+asyncpg://rag_owner:change-me-owner@127.0.0.1:5432/rag_test

# ---- Redis / Qdrant / Temporal (Compose containers, published on localhost) --
RAG_REDIS_URL=redis://127.0.0.1:6379/0
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_TEMPORAL_ADDRESS=127.0.0.1:7233

# ---- Object storage (SeaweedFS S3 gateway) -----------------------------------
RAG_S3_ENDPOINT_URL=http://127.0.0.1:8333
RAG_S3_BUCKET=rag-local-documents
RAG_S3_ACCESS_KEY=change-me-access
RAG_S3_SECRET_KEY=change-me-secret

# ---- Security ----------------------------------------------------------------
# Mixed into API-key hashes. Changing it invalidates every issued key.
RAG_API_KEY_PEPPER=change-me-pepper
# Admin key accepted without a database row (create your first API clients with it).
RAG_BOOTSTRAP_ADMIN_KEY=change-me-admin-key
